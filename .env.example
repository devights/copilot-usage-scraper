# Host port to expose the UI on (default: 5000)
HOST_PORT=5000

# Port Flask listens on inside the container (default: 5000)
PORT=5000

# Host directory where usage.db and browser-state/ are stored (default: ./data)
DATA_DIR=./data

# Seconds between scrapes (default: 3600 = 1 hour)
SCAN_INTERVAL=3600

# VNC port used only during `docker compose run --rm login` (default: 5900)
VNC_PORT=5900
